# EditorConfig: https://editorconfig.org
# Line endings are deliberately not set: the index stores LF, and Windows checkouts may convert (core.autocrlf).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
# Advisory only: many existing files exceed it.
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{cs,py,ps1,qml,cpp,h}]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,xaml,json,yml,yaml,iss}]
indent_style = space
indent_size = 2

# C# analyzers: suggestions only, nothing here may break a build.
[*.cs]
dotnet_analyzer_diagnostic.severity = suggestion
dotnet_style_qualification_for_field = false:suggestion
csharp_style_var_elsewhere = true:suggestion
