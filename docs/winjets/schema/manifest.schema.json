{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Winjet v1 - manifest.json",
  "description": "Manifeste d'un paquet Winjet (format winjet/1). Voir docs/winjets/FORMAT-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "name", "version", "author"],
  "properties": {
    "format": { "const": "winjet/1" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){1,4}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "homepage": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?(/\\S*)?$" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "winlestia": { "type": "string", "pattern": "^(>=|<=|>|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+( (>=|<=|>|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+)*$" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
          }
        }
      }
    }
  }
}
