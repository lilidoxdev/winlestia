<Project Sdk="Microsoft.NET.Sdk">
  <!-- Projet xUnit unique. Les sources testees sont compilees dans l'assembly de test (comme le faisaient les anciens
       Program.cs) : les types `internal` du backend restent ainsi visibles sans InternalsVisibleTo. Categorie Desktop =
       touche au bureau, au son ou a l'explorateur : exclue de la CI, a lancer a la main. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);WFAC010;CS8632;CS0436;xUnit1013</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Memes paquets que le backend. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../../src/backend/**/*.cs" Exclude="../../src/backend/checkpoint-*/**;../../src/backend/obj/**;../../src/backend/bin/**" LinkBase="Backend" />
    <Compile Include="../../src/files/PathRouter.cs" Link="Files/PathRouter.cs" />
  </ItemGroup>
  <!-- Application Files (WPF) : son XAML de styles est charge par reflexion (Styles est internal) dans FilesStylesXamlTests. -->
  <ItemGroup>
    <ProjectReference Include="../../src/files/Winlestia.Files.csproj" />
  </ItemGroup>
  <!-- Echantillonneur FolderIcons.exe (processus separe) copie a cote des tests Desktop d'icones de dossiers. -->
  <ItemGroup>
    <ProjectReference Include="../FolderIcons/FolderIcons.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyFolderIcons" AfterTargets="Build">
    <ItemGroup>
      <FolderIconsFile Include="../FolderIcons/bin/$(Configuration)/$(TargetFramework)/win-x64/FolderIcons.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FolderIconsFile)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
