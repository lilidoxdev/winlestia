<Window x:Class="WinlestiaSetup.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winlestia Setup" Width="1040" Height="680" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Chrome" Background="Transparent">
    <Grid x:Name="BackdropSim" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}">
        <Grid Margin="30,36,24,28">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Image Source="pack://application:,,,/Assets/winlestia-mark.png" Width="52" Height="52" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Winlestia" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,0"/>
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel x:Name="StepsPanel" Grid.Row="1" Margin="0,44,0,0"/>
          <Border x:Name="DryBadge" Grid.Row="2" Visibility="Collapsed" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Padding="12,8" HorizontalAlignment="Left">
            <TextBlock x:Name="DryText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="PageHost" Margin="44,40,44,0" ClipToBounds="True"/>
          <Grid Grid.Row="1" Margin="44,14,44,28">
            <Button x:Name="BackButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnBack"/>
            <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OnNext"/>
          </Grid>
          <Button x:Name="CloseButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" Style="{StaticResource GhostButton}"
                  Padding="11,8" FontFamily="{StaticResource IconFont}" FontSize="12" Content="&#xE711;" Click="OnClose"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
