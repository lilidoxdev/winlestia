                "grow": 1,
                "children": [
                  {
                    "type": "chart",
                    "series": "{{ data.demo.points7d }}",
                    "variant": "line",
                    "axes": true,
                    "color": "accent",
                    "period": "7 derniers jours"
                  }
                ]
              },
              {
