          },
          {
            "type": "divider"
          },
          {
            "type": "column",
            "visibleWhen": "settings.source == 'demo'",
            "children": [
              {
                "type": "list",
                "items": "{{ data.demo.daily }}",
                "title": "day",
                "subtitle": "change",
                "trailing": "price",
                "max": 7
              }
            ]
          },
          {
            "type": "column",
            "visibleWhen": "settings.source == 'live'",
            "children": [
              {
                "type": "text",
                "text": "La liste des jours est disponible avec la source de démonstration.",
                "style": "caption",
                "tone": "secondary"
              }
            ]
          }
