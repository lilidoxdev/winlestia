                  }
                ]
              },
              {
                "type": "column",
                "visibleWhen": "settings.source == 'live' && settings.range == '7d'",
                "grow": 1,
                "children": [
                  {
                    "type": "chart",
                    "series": "{{ data.live7d.prices }}",
                    "variant": "line",
                    "axes": true,
                    "color": "accent",
                    "period": "7 derniers jours"
                  }
                ]
              },
              {
                "type": "column",
                "visibleWhen": "settings.source == 'live' && settings.range == '30d'",
                "grow": 1,
                "children": [
                  {
                    "type": "chart",
                    "series": "{{ data.live30d.prices }}",
                    "variant": "line",
                    "axes": true,
                    "color": "accent",
                    "period": "30 derniers jours"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
