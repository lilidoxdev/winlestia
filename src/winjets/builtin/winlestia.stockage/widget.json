          {
            "type": "row",
            "grow": 2,
            "gap": 16,
            "children": [
              {
                "type": "stack",
                "grow": 2,
                "children": [
                  {
                    "type": "progress",
                    "variant": "ring",
                    "value": "{{ system.diskMain.ratio }}",
                    "label": "{{ system.diskMain.percent }} %",
                    "thickness": 8,
                    "big": true
                  }
                ]
              },
              {
                "type": "column",
                "grow": 3,
                "gap": 2,
                "align": "center",
                "children": [
                  {
                    "type": "text",
                    "text": "Stockage",
                    "style": "eyebrow"
                  },
                  {
                    "type": "text",
                    "text": "{{ system.diskMain.drive }}",
                    "style": "title"
                  },
                  {
                    "type": "text",
                    "text": "{{ system.diskMain.freeGb }} Go libres",
                    "style": "body",
                    "tone": "accent"
                  },
                  {
                    "type": "text",
                    "text": "{{ system.diskMain.usedGb }} sur {{ system.diskMain.totalGb }} Go",
                    "style": "caption",
                    "tone": "secondary"
                  }
                ]
              }
            ]
          }
        ]
      }
